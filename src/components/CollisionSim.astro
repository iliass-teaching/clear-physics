---
// Virtual practical: two trolleys collide and stick together.
// Students set the masses and velocities, predict, then compare momentum before and after.
---

<div class="collision-sim" data-collision-sim>
  <svg viewBox="0 0 660 120" role="img" aria-label="Two trolleys on a track">
    <line x1="20" y1="100" x2="640" y2="100" class="track" />
    <g class="cart a"><rect x="-30" y="58" width="60" height="30" rx="5" /><circle cx="-16" cy="92" r="6" /><circle cx="16" cy="92" r="6" /><text x="0" y="78" text-anchor="middle">A</text></g>
    <g class="cart b"><rect x="-30" y="58" width="60" height="30" rx="5" /><circle cx="-16" cy="92" r="6" /><circle cx="16" cy="92" r="6" /><text x="0" y="78" text-anchor="middle">B</text></g>
  </svg>

  <div class="controls">
    <fieldset>
      <legend>Trolley A</legend>
      <label>mass <input type="range" class="mA" min="1" max="5" step="1" value="2" /> <output class="mA-out">2</output> kg</label>
      <label>velocity <input type="range" class="vA" min="0" max="5" step="0.5" value="3" /> <output class="vA-out">3</output> m/s</label>
    </fieldset>
    <fieldset>
      <legend>Trolley B</legend>
      <label>mass <input type="range" class="mB" min="1" max="5" step="1" value="1" /> <output class="mB-out">1</output> kg</label>
      <label>velocity <input type="range" class="vB" min="-5" max="5" step="0.5" value="0" /> <output class="vB-out">0</output> m/s</label>
    </fieldset>
  </div>
  <p class="small muted">To the right is positive. A negative velocity means the trolley moves to the left.</p>

  <p class="predict">
    <label>Your prediction: velocity after = <input type="text" class="guess" size="6" inputmode="decimal" /> m/s</label>
    <button type="button" class="run">Run the collision</button>
    <button type="button" class="reset secondary">Reset</button>
  </p>
  <p class="msg" aria-live="polite"></p>

  <div class="table-wrap">
    <table class="results">
      <thead><tr><th></th><th>momentum of A / (kg m/s)</th><th>momentum of B / (kg m/s)</th><th>total / (kg m/s)</th></tr></thead>
      <tbody>
        <tr><td>before</td><td class="pA">–</td><td class="pB">–</td><td class="pT">–</td></tr>
        <tr><td>after</td><td colspan="2" class="after-v">–</td><td class="pT2">–</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  const X0 = 40;
  const PX = 58; // pixels per metre, track is 10 m
  const W = 60 / PX; // width of a trolley in metres

  document.querySelectorAll<HTMLElement>('[data-collision-sim]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const inputs = ['mA', 'vA', 'mB', 'vB'].map((k) => q<HTMLInputElement>(`.${k}`));
    const [mAIn, vAIn, mBIn, vBIn] = inputs;
    const cartA = q<SVGGElement>('.cart.a');
    const cartB = q<SVGGElement>('.cart.b');
    const msg = q<HTMLElement>('.msg');
    const guess = q<HTMLInputElement>('.guess');
    let xA = 2;
    let xB = 6;
    let running = false;

    const fmt = (x: number) => String(Number(x.toFixed(2)));
    const place = () => {
      cartA.setAttribute('transform', `translate(${X0 + xA * PX},0)`);
      cartB.setAttribute('transform', `translate(${X0 + xB * PX},0)`);
    };
    const read = () => ({ mA: +mAIn.value, vA: +vAIn.value, mB: +mBIn.value, vB: +vBIn.value });

    function reset(): void {
      running = false;
      xA = 2;
      xB = 6;
      place();
      msg.textContent = '';
      for (const c of ['.pA', '.pB', '.pT', '.after-v', '.pT2']) q<HTMLElement>(c).textContent = '–';
    }

    inputs.forEach((inp) => {
      inp.addEventListener('input', () => {
        q<HTMLOutputElement>(`.${inp.className}-out`).textContent = inp.value;
        reset();
      });
    });

    q<HTMLButtonElement>('.run').addEventListener('click', () => {
      reset();
      const { mA, vA, mB, vB } = read();
      if (vA <= vB) {
        msg.textContent = 'With these velocities, A never catches B. Make A faster than B (to the right).';
        return;
      }
      const pBefore = mA * vA + mB * vB;
      const vAfter = pBefore / (mA + mB);
      q<HTMLElement>('.pA').textContent = fmt(mA * vA);
      q<HTMLElement>('.pB').textContent = fmt(mB * vB);
      q<HTMLElement>('.pT').textContent = fmt(pBefore);
      running = true;
      let stuck = false;
      let last = performance.now();
      const step = (now: number) => {
        if (!running) return;
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        if (!stuck) {
          xA += vA * dt;
          xB += vB * dt;
          if (xB - xA <= W) {
            stuck = true;
            xA = xB - W;
            q<HTMLElement>('.after-v').textContent = `velocity of A and B together: ${fmt(vAfter)} m/s`;
            q<HTMLElement>('.pT2').textContent = fmt((mA + mB) * vAfter);
            const g = Number(guess.value.replace(',', '.'));
            msg.textContent =
              guess.value.trim() === ''
                ? `After the collision, they move together at ${fmt(vAfter)} m/s.`
                : Math.abs(g - vAfter) <= 0.05 + 0.02 * Math.abs(vAfter)
                  ? `Your prediction was right: ${fmt(vAfter)} m/s.`
                  : `Your prediction was ${fmt(g)} m/s. The answer is ${fmt(vAfter)} m/s. Check: total momentum ÷ total mass.`;
          }
        } else {
          xA += vAfter * dt;
          xB += vAfter * dt;
        }
        place();
        if (xA > -1 && xB < 11.5 && !(stuck && Math.abs(vAfter) < 1e-9)) requestAnimationFrame(step);
        else running = false;
      };
      requestAnimationFrame(step);
    });

    q<HTMLButtonElement>('.reset').addEventListener('click', reset);
    reset();
  });
</script>

<style>
  .collision-sim {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 1rem 0 1.5rem;
  }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .track { stroke: var(--ink-soft); stroke-width: 2; }
  .cart rect { fill: var(--surface-2); stroke: var(--accent); stroke-width: 2; }
  .cart.b rect { stroke: var(--exit); }
  .cart circle { fill: var(--ink); }
  .cart text { fill: var(--ink); font-weight: 700; font-size: calc(15px * var(--tz, 1)); font-family: var(--sans); }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.6rem; }
  fieldset { flex: 1; min-width: min(14rem, 100%); border: 1px solid var(--line); border-radius: 8px; padding: 0.4rem 0.9rem 0.6rem; }
  legend { font-weight: 700; font-size: 0.85rem; padding: 0 0.3rem; }
  label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; margin: 0.3rem 0; }
  input[type='range'] { flex: 1; }
  output { min-width: 2.2rem; text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .predict { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 0.8rem 0 0.3rem; }
  .predict label { margin: 0; }
  .msg { min-height: 1.4rem; font-weight: 700; color: var(--accent); }
</style>
